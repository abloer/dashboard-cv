COMPOSE_PROJECT_NAME=dashboard-cv-ut

APP_HOST=dashboard.example.com
TRAEFIK_NETWORK=web
TRAEFIK_CERTRESOLVER=le

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_ANALYSIS_SERVER_URL=/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional: required only for admin backfill writes against hardened RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Security boundary (backend fail-fast when placeholders are left in place).
AUTH_REQUIRED=true
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SESSION_COOKIE_NAME=cv_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=true
AUTH_SESSION_EXCHANGE_ENABLED=true
AUTH_SESSION_EXCHANGE_KEY=replace-with-a-long-random-exchange-key
AUTH_TOKEN_VIEWER=replace-with-viewer-token
AUTH_TOKEN_OPERATOR=replace-with-operator-token
AUTH_TOKEN_ADMIN=replace-with-admin-token
CORS_ORIGINS=https://dashboard.example.com
ARTIFACT_URL_SECRET=replace-with-a-long-random-artifact-secret
ARTIFACT_URL_TTL_SECONDS=900
ARTIFACT_RETENTION_DAYS=7
ARTIFACT_RETENTION_MAX_BYTES=10737418240

PORT=8081
ANALYSIS_OUTPUT_ROOT=/app/runtime-analysis
ANALYSIS_PYTHON_BIN=/opt/venv/bin/python
ANALYSIS_DEFAULT_MODEL_PATH=/app/models/detect-construction-safety-best.pt
HOST_SERVER_DATA_DIR=/srv/hosting/apps/vision-data/server-data
HOST_RUNTIME_ANALYSIS_DIR=/srv/hosting/apps/vision-data/runtime-analysis
HOST_MODELS_DIR=/srv/hosting/apps/vision-data/models
