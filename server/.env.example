SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Required for production/admin backfill writes. Do not expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PORT=8081
ANALYSIS_OUTPUT_ROOT=/app/runtime-analysis
ANALYSIS_PYTHON_BIN=/opt/venv/bin/python
ANALYSIS_DEFAULT_MODEL_PATH=/app/models/detect-construction-safety-best.pt
# Person-estimate stability filter (drops tracker fragments / false-positive
# ghost tracks from the "estimasi orang" count; violators are never dropped).
# A non-violating track counts only if seen >= MIN_STABLE_FRAMES absolute AND
# >= MIN_STABLE_PRESENCE_RATIO of the busiest subject's presence.
ANALYSIS_MIN_STABLE_FRAMES=10
ANALYSIS_MIN_STABLE_PRESENCE_RATIO=0.15
ANALYSIS_JOB_MAX_RETRIES=1
ANALYSIS_JOB_TIMEOUT_MS=1800000
ANALYSIS_JOB_DEFAULT_CONCURRENCY=1
# Format: module.key=limit,module.key=limit. Omit to use ANALYSIS_JOB_DEFAULT_CONCURRENCY.
ANALYSIS_JOB_CONCURRENCY_LIMITS=ppe.no-helmet=1,ppe.no-safety-vest=1,ppe.no-life-vest=1,hse.working-at-height=1,operations.red-light-violation=1,operations.dump-truck-bed-open=1

# Operational repository backend remains JSON by default. Supabase is opt-in
# for admin/backfill utilities until runtime async repository cutover is done.
OPERATIONAL_REPOSITORY_BACKEND=json
OPERATIONAL_REPOSITORY_SUPABASE_ENABLED=false
# Backfill is dry-run by default. To apply: pass --apply and set this to apply.
OPERATIONAL_REPOSITORY_BACKFILL_CONFIRM=dry-run
# Optional dry-run report samples include ID/version/checksum only, never raw payload.
OPERATIONAL_REPOSITORY_BACKFILL_CONFLICT_SAMPLES=0

# Security boundary. Keep AUTH_REQUIRED=true outside isolated local demos.
AUTH_REQUIRED=true
AUTH_JWT_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SESSION_COOKIE_NAME=cv_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
AUTH_SESSION_EXCHANGE_ENABLED=false
AUTH_SESSION_EXCHANGE_KEY=replace-with-a-long-random-exchange-key
AUTH_SESSION_RATE_LIMIT_WINDOW_MS=60000
AUTH_SESSION_RATE_LIMIT_MAX=10
AUTH_TOKEN_VIEWER=replace-with-viewer-token
AUTH_TOKEN_OPERATOR=replace-with-operator-token
AUTH_TOKEN_ADMIN=replace-with-admin-token
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
ARTIFACT_URL_SECRET=replace-with-a-long-random-artifact-secret
ARTIFACT_URL_TTL_SECONDS=900
ARTIFACT_RETENTION_DAYS=7
ARTIFACT_RETENTION_MAX_BYTES=10737418240

# Optional comma-separated allowlists for server-owned model/config files outside defaults.
ANALYSIS_ALLOWED_MODEL_ROOTS=/app/models
ANALYSIS_ALLOWED_CONFIG_ROOTS=/app/config

# Source preview defaults are intentionally restrictive.
SOURCE_PREVIEW_ALLOWED_SCHEMES=rtsp
SOURCE_PREVIEW_ALLOW_PRIVATE_IPS=false
SOURCE_PREVIEW_RATE_LIMIT_WINDOW_MS=60000
SOURCE_PREVIEW_RATE_LIMIT_MAX=20
